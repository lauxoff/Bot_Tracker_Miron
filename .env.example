# Replace with a newly generated token from @BotFather before starting the bot.
BOT_TOKEN=replace-with-your-bot-token

# Required: comma-separated Telegram numeric user IDs allowed to use the bot.
ALLOWED_USER_IDS=123456789

# Only these users can run /reset_today. Leave empty to disable the command.
ADMIN_USER_IDS=123456789

TIMEZONE=Europe/Tallinn
DATABASE_PATH=miron_tracker.db
